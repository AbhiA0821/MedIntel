# MedIntel Environment Configuration Example
# Copy this file to .env and fill in your local credentials.

# Database Configuration
DUCKDB_PATH=database/medintel.duckdb

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_VITALS=medintel-vitals

# Spark Configuration
SPARK_CHECKPOINT_DIR=checkpoints/medintel-vitals

# Prefect Configuration
PREFECT_API_KEY=your_prefect_api_key_here
PREFECT_API_URL=http://127.0.0.1:4200/api

# LLM / AI Agent API Credentials
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
