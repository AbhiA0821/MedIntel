# MedIntel Environment Configurations
FCM_ENABLED=true
FIREBASE_CREDENTIALS_PATH=secrets/firebase_service_account.json
FCM_SERVER_KEY=your_fcm_server_key_here
PIPER_VOICE_ENABLED=true
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_EXECUTABLE_PATH=piper
DUCKDB_PATH=database/medintel.duckdb
API_HOST=127.0.0.1
API_PORT=8000
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_VITALS=medintel-vitals

# Groq LLM & RAG Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=5.0
GROQ_MAX_OUTPUT_TOKENS=512
LLM_ENABLED=true

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=medintel_clinical_knowledge

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Frontend Flask Session Configuration
FLASK_SECRET_KEY=your_secure_random_flask_secret_key_here
FLASK_ENV=development

# Test / Diagnostic Device Configuration
TEST_DEVICE_FCM_TOKEN=
